# Backend
HOST=0.0.0.0
PORT=3001
SENTINEL_DATA_FILE=./data/sentinel.json
SENTINEL_ADMIN_TOKEN=replace-with-a-local-admin-token

# Development-only Vite web server (release UI uses PORT above)
SENTINEL_WEB_PORT=5173
SENTINEL_API_PROXY=http://127.0.0.1:3001

# Browser-side Forge admin calls. Keep this aligned with SENTINEL_ADMIN_TOKEN
# for the prototype launcher. Do not treat this as production authentication.
VITE_ADMIN_TOKEN=replace-with-a-local-admin-token

# Optional trusted HTTPS for microphone capture
# SENTINEL_TLS_CERT=./.certs/localhost-cert.pem
# SENTINEL_TLS_KEY=./.certs/localhost-key.pem

# Optional Gemini draft generation
# GEMINI_API_KEY=

# Optional operations overrides
# SENTINEL_API_URL=http://127.0.0.1:3001
# SENTINEL_WEB_URL=http://127.0.0.1:3001
# SENTINEL_BACKUP_DIR=./data/backups
# SENTINEL_BROWSER_BIN=/path/to/gstack/browse
